# App
APP_NAME="Proovy Agent"
APP_VERSION="0.1.0"
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000

# LLM (OpenRouter)
OPENROUTER_API_KEY=sk-or-...

# TTS (Inworld)
INWORLD_TTS_API_KEY=...
# Alias supported for existing local envs: INWORLD_API_KEY
VIDEO_TTS_MODEL=inworld-tts-1.5-max
# Alias supported for existing local envs: INWORLD_TTS_MODEL_ID
VIDEO_TTS_VOICE=Hyunwoo
# Alias supported for existing local envs: INWORLD_TTS_VOICE_ID
VIDEO_TTS_SPEAKING_RATE=0.95
VIDEO_TTS_TEMPERATURE=0.9
VIDEO_TTS_TIMESTAMP_TYPE=WORD
VIDEO_TTS_TIMEOUT_SECONDS=60

# Sandbox (Daytona)
DAYTONA_API_KEY=...
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
DAYTONA_SNAPSHOT=proovy-math-sandbox
DAYTONA_SANDBOX_CPU=2
DAYTONA_SANDBOX_MEMORY=2
DAYTONA_SANDBOX_DISK=5
DAYTONA_AUTO_STOP_INTERVAL=5
DAYTONA_CODE_TIMEOUT=60
DAYTONA_MAX_OUTPUT_CHARS=10000
SANDBOX_PREAMBLE_NAME=math_v1

# Database (LangGraph checkpoint)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/proovy
