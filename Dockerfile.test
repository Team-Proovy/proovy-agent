# PDF 테스트용 Dockerfile
FROM python:3.12-slim

# WeasyPrint 의존성 설치
RUN apt-get update && apt-get install -y \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libfontconfig1 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libgtk-3-0 \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# uv 설치
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 프로젝트 파일 복사
COPY . .

# 의존성 설치
RUN uv sync

# 테스트 실행
CMD ["uv", "run", "python", "-m", "tests.pdf_node.test_pdf_node"]