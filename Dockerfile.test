# PDF 테스트용 Dockerfile
FROM python:3.12-slim

# 비root 사용자 생성
RUN useradd -m -u 10001 appuser

# WeasyPrint 의존성 설치
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libfontconfig1 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libgtk-3-0 \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# uv 설치 (root 단계 — 시스템 경로 쓰기)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 프로젝트 파일 복사 후 소유권을 appuser로 — 그래야 uv sync(editable 빌드)가
# src/*.egg-info를 생성할 수 있다. (chown은 반드시 COPY 이후 root 권한으로)
COPY . .
RUN chown -R appuser:appuser /app
USER appuser

# 의존성 설치
RUN uv sync

# 테스트 실행
CMD ["uv", "run", "python", "-m", "tests.pdf_node.test_pdf_node"]
